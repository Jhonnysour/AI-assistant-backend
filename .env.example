# Configuración local. Copiar a .env (no versionado) y ajustar. La leen el backend y docker compose.
# Una variable definida en la terminal ($env:...) tiene prioridad sobre este archivo.

# --- PostgreSQL (docker compose) ---
POSTGRES_PASSWORD=cambia-esta-contraseña
# Puerto local de PostgreSQL (opcional, por defecto 5432).
# AI_ASSISTANT_DB_PORT=5432

# --- Backend ---
# Proveedor de IA: fake (simulado, gratis), chatgpt_plan (Sign in with ChatGPT) u openrouter (API key,
# de pago por uso; la key se guarda cifrada con tools.openrouter set-key, nunca aquí).
AI_ASSISTANT_PROVIDER=fake
# Modelos de OpenRouter que muestra el selector, separados por comas (opcional).
# AI_ASSISTANT_OPENROUTER_MODELS=deepseek/deepseek-v4.1-flash-1017
# Conversaciones en PostgreSQL. Sin esta línea viven en memoria y se pierden al reiniciar.
AI_ASSISTANT_DATABASE_URL=postgresql://ai_assistant:${POSTGRES_PASSWORD}@127.0.0.1:${AI_ASSISTANT_DB_PORT:-5432}/ai_assistant
# Base de datos de las pruebas (se vacía en cada prueba; nunca apuntarla a ai_assistant).
AI_ASSISTANT_TEST_DATABASE_URL=postgresql://ai_assistant:${POSTGRES_PASSWORD}@127.0.0.1:${AI_ASSISTANT_DB_PORT:-5432}/ai_assistant_test
# Puerto de la API (opcional, por defecto 8000).
# AI_ASSISTANT_API_PORT=8000

# --- Red hacia el proveedor (chatgpt_plan y openrouter) ---
# HTTP_PROXY=http://127.0.0.1:17890
# HTTPS_PROXY=http://127.0.0.1:17890
# NO_PROXY=localhost,127.0.0.1,::1
# Comando para abrir el perfil de Chrome con proxy en el login (opcional).
# AI_ASSISTANT_BROWSER="C:\Program Files\Google\Chrome\Application\chrome.exe" --profile-directory="Profile 1"
